      "definition": "FOREIGN KEY (bonus_campaign_id, bonus_month) REFERENCES used_car_bonus_months(campaign_id, month)"
    },
    {
      "name": "payments_campaign_bonus_shape",
      "definition": "CHECK (((type <> 'campaign_bonus'::text) OR ((bonus_campaign_id IS NOT NULL) AND (bonus_month IS NOT NULL) AND (recipient_type = 'user'::text) AND (car_id IS NULL) AND (amount > (0)::numeric))))"
