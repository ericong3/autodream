      "definition": "CHECK (((claim_kind IS NULL) OR (claim_kind = ANY (ARRAY['repair'::text, 'misc'::text]))))"
    },
    {
      "name": "payments_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "payments_recipient_type_check",
